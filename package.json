{
  "name": "@platform/paperclip-plugin-cad",
  "version": "0.1.9",
  "type": "module",
  "private": true,
  "description": "CadQuery plugin for Paperclip — lets agents design and render 3D CAD models via tool calls",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "postbuild": "npm run check:manifest-version",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node ./scripts/validate-manifest.mjs",
    "check:manifest-version": "node ./scripts/check-manifest-version.mjs",
    "check:release-tarball": "node ./scripts/check-release-tarball.mjs --keep",
    "check:release-tarball:self-test": "node ./scripts/check-release-tarball.mjs --self-test",
    "prepack": "make -C worker && npm run build && npm run validate:manifest"
  },
  "files": [
    "dist/",
    "src/cad_worker.py",
    "src/manifest.ts",
    "src/cad-worker-client.ts",
    "src/stub-cad-worker.ts",
    "src/worker.ts",
    "worker/Makefile",
    "worker/cad_preexec",
    "worker/cad_preexec.c",
    "worker/measure-clone-fallback.sh",
    "worker/requirements-cad.txt",
    "worker/seccomp-evidence.md",
    "worker/seccomp_filter.bpf",
    "worker/seccomp_filter.bpf.sha256",
    "worker/seccomp_filter.c",
    "worker/seccomp_filter_compile",
    "worker/seccomp_load.py",
    "scripts/validate-manifest.mjs",
    "scripts/check-manifest-version.mjs",
    "scripts/check-release-tarball.mjs",
    "esbuild.config.mjs",
    "tsconfig.json",
    "vitest.config.ts",
    "SKILL.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "cad",
    "cadquery",
    "3d"
  ],
  "author": "Platform",
  "license": "MIT",
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.428.0"
  },
  "devDependencies": {
    "@paperclipai/shared": "2026.428.0",
    "@types/node": "24.12.2",
    "esbuild": "0.27.7",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
